---
const pins = Array.from({ length: 20 }, (_, i) => 30 + i * 6);
---
<svg class="device" viewBox="0 0 200 132" role="img" aria-label="Single-board computer used as the on-board server, with a pin header, processor and ports.">
  <rect class="device-detail" x="160" y="40" width="32" height="22" rx="2" />
  <rect class="device-detail" x="160" y="68" width="32" height="22" rx="2" />
  <rect class="device-detail" x="160" y="96" width="32" height="20" rx="2" />
  <rect class="device-detail" x="2" y="58" width="16" height="22" rx="2" />
  <rect class="device-detail" x="34" y="116" width="16" height="10" rx="2" />
  <rect class="device-detail" x="62" y="116" width="14" height="10" rx="2" />
  <rect class="device-detail" x="86" y="116" width="14" height="10" rx="2" />

  <rect class="device-case" x="10" y="16" width="170" height="106" rx="8" />
  <circle class="device-detail" cx="20" cy="26" r="3.5" />
  <circle class="device-detail" cx="152" cy="26" r="3.5" />
  <circle class="device-detail" cx="20" cy="112" r="3.5" />
  <circle class="device-detail" cx="152" cy="112" r="3.5" />

  {pins.map((x) => (
    <>
      <circle class="device-pin" cx={x} cy="24" r="1.6" />
      <circle class="device-pin" cx={x} cy="30" r="1.6" />
    </>
  ))}

  <rect class="device-screen" x="58" y="52" width="36" height="36" rx="3" />
  <rect class="device-detail" x="65" y="59" width="22" height="22" rx="1" />
  <rect class="device-screen" x="104" y="56" width="24" height="30" rx="2" />
  <path class="device-detail" d="M34 58 h14 M34 66 h14 M34 74 h14 M138 60 v24 M146 60 v24" />

  <circle cx="30" cy="96" r="2.5" style="fill: var(--state-ok)" class="device-led" />
  <circle cx="30" cy="105" r="2.5" style="fill: var(--band-5)" />
</svg>
