---
import { Image } from 'astro:assets';
import products from '../assets/products.png';
import { home } from '../site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Designed for life beyond Earth</p>
    <h1 id="hero-title">Human signals.<br /><span>Onboard intelligence.</span></h1>
    <p class="lede">A quiet presence on the wrist. An intelligent companion on board.
      Personal health monitoring that stays with the crew, even when Earth is out of reach.</p>
    <div class="hero-actions">
      <a class="button" href="#wristband">Explore the system <span aria-hidden="true">↓</span></a>
      <a class="text-link" href={`${home}demo/`}>Enter the live demo <span aria-hidden="true">↗</span></a>
    </div>
    <p class="hero-note">Hardware concept · Working simulation · Synthetic data</p>
  </div>
  <figure class="hero-stage">
    <Image src={products}
      alt="A seamless graphite Spectra wristband with inner optical sensors beside the compact, rounded onboard server."
      widths={[640, 960, 1280, 1536]} sizes="(min-width: 1000px) 62vw, 100vw"
      loading="eager" fetchpriority="high" quality={88} />
    <figcaption class="render-note">AI-generated concept image</figcaption>
  </figure>
  <div class="hero-foot">
    <span>01 / SENSE</span><span>02 / UNDERSTAND</span><span>03 / CONNECT</span>
    <a href="#problem">Discover Spectra <span aria-hidden="true">↓</span></a>
  </div>
</section>
