---
import { site } from '../site';
---
<!-- The team: a few adults, one two-year-old consultant. The consultant's main contribution was removing the laptop charger at key moments. -->
<section class="section team" id="team">
  <p class="eyebrow">10 / Team</p>
  <h2 class="section-title">Built for the NASA hackathon.</h2>
  <p>Interested in the science, the hardware or the next iteration? Talk to the team.</p>
  <ul>
    {site.emails.map((email) => (
      <li><a href={`mailto:${email}`}>{email}</a></li>
    ))}
    <li><a href={site.repoUrl} rel="noopener">Source code on GitHub</a></li>
  </ul>
</section>
