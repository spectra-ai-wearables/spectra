---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
const bars = [
  { x: 2, height: 10, nm: 590, glyph: 'H' },
  { x: 8, height: 18, nm: 445, glyph: 'I' },
  { x: 14, height: 26, nm: 680, glyph: 'T' },
  { x: 20, height: 20, nm: 415, glyph: 'L' },
  { x: 26, height: 12, nm: 515, glyph: 'G' },
];
---
<span class="logo">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    {bars.map((bar, i) => (
      <rect
        class={`logo-band logo-band-${i + 1}`}
        x={bar.x}
        y={29 - bar.height}
        width="4"
        height={bar.height}
        rx="2"
        data-nm={bar.nm}
        data-glyph={bar.glyph}
      />
    ))}
  </svg>
  <span class="logo-word">Spectra</span>
</span>
