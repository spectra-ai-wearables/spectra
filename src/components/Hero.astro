---
import { Image } from 'astro:assets';
import gadget from '../assets/gadget.jpeg';
import { home } from '../site';
import Logo from './Logo.astro';
---
<header class="site-header">
  <a href={home} aria-label="Spectra home"><Logo /></a>
  <nav aria-label="Sections">
    <a href="#wristband">Wristband</a>
    <a href="#server">Onboard server</a>
    <a href="#demo">Demo</a>
    <a href="#model">Model</a>
    <a href="#status">Status</a>
    <a href="#team">Team</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">On-board health monitoring for astronauts</p>
    <h1>Turn body signals into information astronauts can use on board.</h1>
    <p class="lede">
      Spectra pairs a screenless multispectral wristband with a compact onboard server.
      Readings are checked and analyzed on the spacecraft, and events wait in a queue until
      spacecraft communications can carry them to Earth.
    </p>
    <div class="hero-actions">
      <a class="button" href="#demo">Run the demo</a>
      <a class="text-link" href="#wristband">See the hardware</a>
    </div>
    <p class="hero-note">Proposed hardware and model. The demo runs on synthetic data.</p>
  </div>
  <figure class="hero-stage">
    <Image
      src={gadget}
      alt="The Spectra wristband, a screenless titanium-colored band with optical sensors on its inner face, standing beside the compact onboard server."
      widths={[640, 960, 1280, 1536]}
      sizes="(min-width: 1536px) 1536px, 120vw"
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
    <figcaption>Concept render: the wristband and the onboard server.</figcaption>
  </figure>
</section>
