---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  /** Short description; the annotations are repeated as text near the figure. */
  alt: string;
  title: string;
  /** "render" blends a lit product scene; "blueprint" sits on a matching navy band. */
  variant: 'render' | 'blueprint';
}

const { image, alt, title, variant } = Astro.props;
const full = await getImage({ src: image, width: image.width, format: 'webp', quality: 88 });
---
<figure class={`plate plate-${variant} bleed`}>
  <a class="plate-link" href={full.src} data-enlarge data-title={title}>
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1536]}
      sizes="(min-width: 1536px) 1536px, 100vw"
      quality={82}
    />
    <span class="plate-zoom">Enlarge <span aria-hidden="true">+</span></span>
  </a>
  <figcaption><slot /></figcaption>
</figure>
