---
import { CHART, PHASE_MARKS, xAt } from '../demo/chart';
import { SPECTRAL_BANDS_NM } from '../sim/generator';

const scenarios = [
  { id: 'usual', label: 'Usual recovery', description: 'Follow a typical session' },
  { id: 'misplaced', label: 'Sensor misplaced', description: 'See how signal checks respond' },
  { id: 'atypical', label: 'Atypical recovery, no link', description: 'See events saved on board' },
];
const gridHr = [60, 100, 140];
const plotBottom = CHART.height - CHART.bottom;
const gridY = (hr: number) =>
  CHART.top + (1 - (hr - CHART.minHr) / (CHART.maxHr - CHART.minHr)) * (plotBottom - CHART.top);
---
<section class="section demo-section" id="demo">
  <div class="console-heading">
    <div><p class="eyebrow">Live telemetry</p><h2 class="section-title">Crew &amp; ground.</h2></div>
    <p>One session, two perspectives.<br />Local inference keeps running when the link goes down.</p>
  </div>

  <noscript>
    <p class="demo-fallback">
      The interactive demo needs JavaScript. Everything else on this page works without it.
    </p>
  </noscript>

  <div class="demo" data-demo hidden>
    <div class="demo-bar">
      <div class="scenario-group"><p class="control-label">01 / Choose a scenario</p>
      <div class="demo-scenarios" role="group" aria-label="Scenario">
        {scenarios.map((scenario) => (
          <button type="button" data-scenario={scenario.id} aria-pressed="false">
            <strong>{scenario.label}</strong><small>{scenario.description}</small>
          </button>
        ))}
      </div>
      </div>
      <div class="controls-group"><p class="control-label">02 / Session controls</p>
      <div class="demo-controls">
        <button type="button" data-play>Start session</button>
        <button type="button" data-reset>Restart</button>
        <button type="button" role="switch" aria-checked="true" data-link>
          Link to Earth
        </button>
        <button type="button" data-fullscreen>Focus mode</button>
        <button type="button" data-logs aria-pressed="false" aria-controls="demo-log">System log</button>
        <button type="button" data-insights>Review session</button>
      </div>
      </div>
      <p class="demo-badge">Synthetic data</p>
    </div>

    <dl class="telemetry">
      <div><dt>Mission clock</dt><dd>T+<span data-clock>00:00</span></dd></div>
      <div><dt>Phase</dt><dd data-phase>Rest</dd></div>
      <div><dt>Sensor</dt><dd data-sensor data-level="idle">Standby</dd></div>
      <div><dt>Model score</dt><dd data-model-score data-level="idle">Awaiting data</dd></div>
      <div><dt>Link</dt><dd data-link-cell data-level="ok">Up</dd></div>
      <div><dt>Queue</dt><dd data-queue data-level="idle">0 pending</dd></div>
    </dl>

    <div class="demo-panels">
      <article class="panel panel-astronaut" aria-labelledby="panel-astronaut-title">
        <header class="panel-header">
          <h3 id="panel-astronaut-title">Astronaut dashboard</h3>
        </header>

        <div class="reading" data-reading data-state="idle" aria-live="polite">
          <p class="reading-label" data-label>Ready when you are</p>
          <p class="reading-detail" data-detail>Choose a scenario, then select Start session.</p>
          <p class="reading-action"><strong>Next:</strong> <span data-action>Awaiting data</span></p>
        </div>

        <div class="detectors">
          <div class="detector" data-detector="model" data-verdict="none">
            <p class="detector-name">On-board model <span class="tag">Neural network</span></p>
            <p class="detector-value"><span data-score>Awaiting data</span> <span data-verdict-text></span></p>
            <div class="meter" aria-hidden="true"><span class="meter-fill"></span></div>
          </div>
          <div class="detector" data-detector="baseline" data-verdict="none">
            <p class="detector-name">Statistical baseline <span class="tag">For comparison</span></p>
            <p class="detector-value"><span data-score>Awaiting data</span> <span data-verdict-text></span></p>
            <div class="meter" aria-hidden="true"><span class="meter-fill"></span></div>
          </div>
          <p class="detectors-note">
            Deviation score: how far the last window is from this astronaut's pattern, in
            units of their usual variation. The mark is the threshold of 3; three windows in a
            row above it ask for a check. It is not a probability of illness.
          </p>
        </div>

        <figure class="chart">
          <svg viewBox={`0 0 ${CHART.width} ${CHART.height}`} role="img"
            aria-label="Heart rate over the session against the individual baseline band">
            {gridHr.map((hr) => (
              <g class="chart-grid">
                <line x1={CHART.left} x2={CHART.width - CHART.right} y1={gridY(hr)} y2={gridY(hr)} />
                <text x={CHART.left - 6} y={gridY(hr)} text-anchor="end" dominant-baseline="middle">{hr}</text>
              </g>
            ))}
            {PHASE_MARKS.map((mark) => (
              <g class="chart-phase">
                <line x1={xAt(mark.t)} x2={xAt(mark.t)} y1={CHART.top} y2={plotBottom} />
                <text x={xAt(mark.t) + 4} y={CHART.height - 8}>{mark.label}</text>
              </g>
            ))}
            <path class="chart-band" data-band d="" />
            <path class="chart-line" data-line d="" fill="none" />
            <circle class="chart-head" data-head r="4" cx="-10" cy="-10" />
            <line class="chart-cursor" data-cursor x1={CHART.left} x2={CHART.left} y1={CHART.top} y2={plotBottom} />
          </svg>
          <figcaption>Heart rate (bpm). Shaded band: this astronaut's reference for the activity.</figcaption>
        </figure>

        <dl class="metrics">
          <div><dt>Heart rate</dt><dd><span data-hr data-missing-value="true">No data</span> <small>bpm</small></dd></div>
          <div><dt>Skin temperature</dt><dd><span data-temp data-missing-value="true">No data</span> <small>°C</small></dd></div>
          <div><dt>Signal quality</dt><dd data-quality>Awaiting data</dd></div>
        </dl>

        <div class="spectral">
          <p class="spectral-title">Spectral channels <span class="tag">Experimental</span></p>
          <ul class="spectral-bars">
            {SPECTRAL_BANDS_NM.map((nm) => (
              <li data-bar style="--level: 0">
                <span class="spectral-bar" aria-hidden="true"></span>
                <span class="spectral-nm">{nm}</span>
              </li>
            ))}
          </ul>
          <p class="spectral-note">Wavelength in nm. Shown as collected; no health indicator is derived from these channels.</p>
        </div>
      </article>

      <div class="demo-side">
      <article class="panel panel-ground" aria-labelledby="panel-ground-title">
        <header class="panel-header">
          <h3 id="panel-ground-title">Ground team</h3>
          <p class="link-status" data-link-status data-connected="true">Link up</p>
        </header>
        <p class="events-empty" data-empty>No events to review. Updates appear here when a change persists.</p>
        <ol class="events" data-events aria-live="polite"></ol>
      </article>

      <article class="panel panel-insights" data-insights-panel hidden aria-labelledby="panel-insights-title">
        <header class="panel-header">
          <h3 id="panel-insights-title">Session insights</h3>
          <p class="panel-meta" data-insights-time></p>
        </header>
        <dl class="insights" data-insights-list></dl>
        <p class="panel-note">
          Computed on board from this session's readings with fixed rules. A summary, not a
          diagnosis.
        </p>
      </article>

      <article class="panel panel-log" id="demo-log" data-log-panel hidden aria-labelledby="panel-log-title">
        <header class="panel-header">
          <h3 id="panel-log-title">System log</h3>
          <p class="panel-meta"><span data-log-count>0</span> entries</p>
        </header>
        <ol class="log" data-log role="log" aria-label="System log" tabindex="0"></ol>
      </article>
      </div>
    </div>
  </div>
</section>

<script>
  import '../demo/main';
</script>
