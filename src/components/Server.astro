---
import architecture from '../assets/server-exploded-clean.png';
import ComponentStudy from './ComponentStudy.astro';

const parts = [
  { name: 'Aluminum enclosure', role: 'Compact, durable housing for the compute board.' },
  { name: 'Thermal spreader', role: 'Distributes heat from the compute board for quiet, stable operation.' },
  { name: 'Raspberry Pi compute board', role: 'Single-board computer for onboard data processing and control.' },
  { name: 'Local storage', role: 'Solid-state storage for data, models and event buffering.' },
  { name: 'Wireless antenna', role: 'Sits behind an RF window for local wireless links, such as Wi-Fi or Bluetooth LE.' },
  { name: 'Power and network I/O', role: 'Recessed connectors for power and wired networking.' },
];

const pipeline = [
  {
    name: 'Quality check',
    text: 'Each window of readings is checked for skin contact, missing data and motion. An unreliable window is never scored.',
  },
  {
    name: 'Local ML inference',
    text: 'A model compares reliable windows with the astronaut’s own pattern. This runs on the server, so it needs no link to Earth.',
  },
  {
    name: 'Event buffer',
    text: 'When a deviation persists, an event is written to local storage. Events are kept in order and wait there while the link is down.',
  },
  {
    name: 'Earth sync',
    text: 'The server hands queued events to the spacecraft’s communication system. They reach the ground team when that link allows, with its delay.',
  },
];
---
<section class="section product-section" id="server">
  <p class="eyebrow">02 / Onboard server</p>
  <h2 class="section-title">Intelligence stays on board.</h2>
  <p class="section-lede">
    The server checks each reading, compares it with the astronaut’s reference and keeps
    important events ready for the ground team.
  </p>
  <p>
    A Raspberry Pi single-board computer inside a compact aluminum enclosure receives the
    wristband's readings over a local wireless link. It runs the analysis, keeps a bounded
    history and stores events. It does not talk to Earth by itself: Earth sync uses
    spacecraft communications, whenever the mission has a link.
  </p>

  <ComponentStudy image={architecture} parts={parts} title="Onboard server assembly"
    alt="Exploded view of the Spectra server: enclosure, thermal spreader, Raspberry Pi, local storage and base." />

  <h3 class="subsection-title">From a reading to the ground team</h3>
  <ol class="steps">
    {pipeline.map((step) => (
      <li>
        <h4>{step.name}</h4>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>


</section>
