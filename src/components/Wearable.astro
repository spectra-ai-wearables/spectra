---
import { Image } from 'astro:assets';
import gadget from '../assets/gadget.jpeg';

const sensors = [
  {
    name: 'Optical pulse sensor',
    role: 'Captures the pulse wave and estimates heart rate.',
    tag: null,
  },
  {
    name: 'Multispectral sensor',
    role: 'Records the optical response across several wavelength bands and feeds them to the on-board model. We are investigating whether the extra bands help recognize unreliable readings.',
    tag: 'Experimental',
  },
  {
    name: 'Accelerometer',
    role: 'Records movement and helps identify readings affected by motion.',
    tag: null,
  },
  {
    name: 'Contact temperature sensor',
    role: 'Tracks the trend of skin temperature. It is not core body temperature.',
    tag: 'Skin temperature',
  },
  {
    name: 'In-app check-in',
    role: 'Perceived effort, sleep and well-being, reported by the astronaut.',
    tag: 'Self-reported',
  },
];
---
<section class="section" id="wearable">
  <p class="eyebrow">The wearable</p>
  <h2 class="section-title">Each sensor has one job.</h2>
  <figure class="gadget">
    <div class="gadget-photo">
      <Image
        src={gadget}
        alt="Close view of the inner face of the Spectra band: two green emitters, a central optical sensor and a metal contact pad."
        widths={[960, 1536]}
        sizes="(min-width: 720px) 60rem, 230vw"
      />
    </div>
    <ul class="gadget-legend">
      <li><strong>Optical pulse sensor</strong> on the inner face, against the skin.</li>
      <li><strong>Multispectral sensor</strong>, eight bands from 415 to 680 nm. <span class="tag">Experimental</span></li>
      <li><strong>Contact pad</strong> for skin temperature.</li>
      <li><strong>Accelerometer</strong> inside the band, for movement and reading quality.</li>
      <li><strong>No screen.</strong> The astronaut reads the dashboard on a separate display.</li>
    </ul>
    <figcaption>Concept render of the band's inner face.</figcaption>
  </figure>
  <table class="sensor-table">
    <thead>
      <tr>
        <th scope="col">Component</th>
        <th scope="col">Role in Spectra</th>
      </tr>
    </thead>
    <tbody>
      {sensors.map((sensor) => (
        <tr>
          <th scope="row">
            {sensor.name}
            {sensor.tag && <span class="tag">{sensor.tag}</span>}
          </th>
          <td>{sensor.role}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>
    A multispectral sensor measures the spectral content of light. That alone does not make
    it a validated measure of glucose, hydration or disease, and Spectra does not claim it is.
  </p>
</section>
