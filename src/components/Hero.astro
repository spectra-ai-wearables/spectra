---
import { Image } from 'astro:assets';
import gadget from '../assets/gadget.jpeg';
import { home } from '../site';
import Logo from './Logo.astro';
---
<header class="site-header">
  <a href={home} aria-label="Spectra home"><Logo /></a>
  <nav aria-label="Sections">
    <a href="#how">How it works</a>
    <a href="#demo">Demo</a>
    <a href="#wearable">Wearable</a>
    <a href="#analysis">On-board AI</a>
    <a href="#limits">Limits</a>
    <a href="#team">Team</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">On-board AI health monitoring for astronauts</p>
    <h1>Turn body signals into information astronauts can use on board.</h1>
    <p class="lede">
      Spectra pairs a multispectral wearable with machine learning designed to run on the
      spacecraft. It checks whether a reading can be trusted, compares it with the astronaut's
      own pattern, and explains what changed, with or without a link to Earth.
    </p>
    <a class="button" href="#demo">Run the demo</a>
    <p class="hero-note">Hackathon prototype. The demo runs on synthetic data.</p>
  </div>
  <figure class="hero-figure">
    <Image
      src={gadget}
      alt="The Spectra band, a screenless wristband with optical sensors on its inner face, next to the compact on-board server."
      widths={[480, 960, 1536]}
      sizes="(min-width: 900px) 34rem, 100vw"
      loading="eager"
    />
    <figcaption>Concept render: the band and the on-board server.</figcaption>
  </figure>
</section>
