---
const bars = [8, 13, 18, 13, 9];
---
<svg class="device" viewBox="0 0 240 320" role="img" aria-label="Front of the Spectra watch: a rounded case showing heart rate, a pulse trace and five spectral bars.">
  <path class="device-band" d="M84 88 V14 a12 12 0 0 1 12 -12 h48 a12 12 0 0 1 12 12 V88" />
  <path class="device-band" d="M84 232 V306 a12 12 0 0 0 12 12 h48 a12 12 0 0 0 12 -12 V232" />
  <path class="device-detail" d="M98 30 h44 M98 46 h44 M98 62 h44" />
  <circle class="device-detail" cx="120" cy="262" r="3" />
  <circle class="device-detail" cx="120" cy="280" r="3" />
  <circle class="device-detail" cx="120" cy="298" r="3" />

  <rect class="device-crown" x="192" y="140" width="7" height="26" rx="3.5" />
  <rect class="device-case" x="48" y="80" width="144" height="160" rx="40" />
  <rect class="device-screen" x="60" y="92" width="120" height="136" rx="30" />

  <text class="device-label" x="80" y="124">HR</text>
  <text class="device-value" x="79" y="160">62</text>
  <text class="device-label" x="126" y="160">bpm</text>
  <polyline class="device-trace" points="78,186 94,186 100,178 106,194 112,170 118,186 134,186 140,180 146,190 152,186 164,186" />
  {bars.map((height, i) => (
    <rect x={80 + i * 11} y={214 - height} width="7" height={height} rx="2" style={`fill: var(--band-${i + 1})`} />
  ))}
</svg>
