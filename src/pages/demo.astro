---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Demo from '../components/Demo.astro';
import { home } from '../site';
import products from '../assets/products.png';
---
<Base demo title="Mission simulator / Spectra" description="Explore Spectra's onboard intelligence with simulated astronaut readings, local machine learning and an interruptible Earth link.">
  <Header demo />
  <main id="main">
    <section class="mission-intro" aria-labelledby="mission-title">
      <div>
        <a class="back-link" href={home}>← Back to the system</a>
        <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Interactive mission simulator</p>
        <h1 id="mission-title">Intelligence.<br /><span>Independent of distance.</span></h1>
        <p>From the first reading to the ground team. Explore how Spectra checks signals,
          recognizes changes and keeps events safe when the link is interrupted.</p>
      </div>
      <figure class="mission-product">
        <Image src={products} alt="The Spectra screenless wristband and onboard server concept."
          widths={[480, 720, 960]} sizes="(min-width: 900px) 32vw, 80vw" loading="eager" />
        <figcaption>WRISTBAND <span aria-hidden="true">→</span> ONBOARD SERVER <span aria-hidden="true">→</span> EARTH</figcaption>
      </figure>
    </section>
    <div class="mission-context">
      <span>SIMULATED SESSION <b>05:00</b></span>
      <span>PLAYBACK <b>10×</b></span>
      <span>INFERENCE <b>LOCAL</b></span>
      <span>DATA SOURCE <b>SYNTHETIC</b></span>
    </div>
    <Demo />
    <section class="mission-guide" aria-labelledby="guide-title">
      <div><p class="eyebrow">Reading the simulation</p><h2 id="guide-title">A signal.<br />Not a diagnosis.</h2></div>
      <div>
        <p>A small neural network compares heart rate and skin temperature with a learned reference.
          The statistical baseline runs alongside it. Unreliable readings are excluded before scoring.</p>
        <p>Three consecutive windows above the deviation threshold ask for a check.
          Events wait locally when the link is down and are delivered after the simulated transmission delay.</p>
        <a class="text-link" href={`${home}#model`}>Explore the model and evaluation ↗</a>
      </div>
    </section>
  </main>
  <footer class="site-footer"><a href={home}>Spectra / Back to the system</a><span>Research prototype · Synthetic data</span></footer>
</Base>
