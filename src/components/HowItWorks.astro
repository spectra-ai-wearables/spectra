---
const steps = [
  {
    title: 'Wearable',
    text: 'A multispectral sensor on the astronaut’s wrist, with pulse and motion sensors beside it, collects the readings.',
  },
  {
    title: 'On-board server',
    text: 'A compact computer on the spacecraft receives the readings, keeps a bounded history and runs the machine-learning analysis locally.',
  },
  {
    title: 'Signal quality and analysis',
    text: 'Each window is checked for contact and motion first. Only reliable windows are compared with the astronaut’s own pattern.',
  },
  {
    title: 'Astronaut dashboard',
    text: 'Shows the state of the readings, what changed, and the next action, in plain language.',
  },
  {
    title: 'Event queue',
    text: 'Relevant events are saved on board and wait there while the link is down.',
  },
  {
    title: 'Ground team',
    text: 'When communication returns, the queue is sent and the ground receives a summary of each event.',
  },
];
---
<section class="section" id="how">
  <p class="eyebrow">How it works</p>
  <h2 class="section-title">From the wrist to the ground, without depending on the link.</h2>
  <ol class="steps">
    {steps.map((step) => (
      <li>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>
