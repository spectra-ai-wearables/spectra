---
import Challenges from '../components/Challenges.astro';
import { home, site } from '../site';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/demo.css';
import '../styles/monitor.css';
import '../styles/motion.css';
import '../styles/experience.css';
import '../styles/ops.css';
interface Props { title?: string; description?: string; demo?: boolean }
const { title = site.title, description = site.description, demo = false } = Astro.props;
---
<!doctype html>
<!--
  Spectra was designed over one weekend, much of it at a second birthday party.
  One of us is a parent; the guest of honor supervised from under the table.
  If a variable name looks like it was typed with one hand, there was cake in the other.

  You read source. Good. Here is a signal for you: dGhlIHdvcmQgaXMgYmFzZWxpbmU=
  Then open the console.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class:list={[{ 'demo-page': demo }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <Challenges />
  </body>
</html>
